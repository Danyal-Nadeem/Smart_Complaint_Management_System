# Server
PORT=
NODE_ENV=development

# MongoDB
MONGODB_URI=

# Authentication
JWT_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=

# Admin
SUPER_ADMIN_EMAIL=
